# Copia este archivo como .env y completa los valores vacíos.
# Nunca subas el archivo .env al repositorio.

# --- Base de datos ---
# Archivo SQLite de la aplicación. Se crea con `npm run db:reiniciar`.
DB_ARCHIVO=./data/lorax.db

# --- Sesión ---
# Clave para firmar los JWT de sesión (HS256). Usa un valor aleatorio largo.
# Para generarla: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión normal, en horas.
SESION_HORAS=8
# Duración de la sesión con «Mantener sesión iniciada», en días.
SESION_RECORDAR_DIAS=30

# --- Aplicación ---
# Dirección pública de la aplicación. Se usa en los enlaces de los correos;
# si empieza con https, la cookie de sesión lleva el atributo Secure.
APP_URL=http://localhost:3000

# --- Ingesta ---
# Clave que el servidor de red (o el emulador) envía en el encabezado X-Api-Key.
# Genérala igual que JWT_SECRET.
INGESTA_API_KEY=

# --- Notificaciones ---
# Solo para probar los reintentos: canales que fallan a propósito, separados por comas
# (CORREO, SMS, WHATSAPP). Déjalo vacío para el uso normal.
NOTIF_SIMULAR_FALLO=
